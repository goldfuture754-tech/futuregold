<body>

  <!-- Header -->
  <header>
    <div class="container nav">

      <a href="#home" class="logo" aria-label="المستقبل الذهبي"><img class="brand-logo" src="images/logo.png" alt="شعار المستقبل الذهبي" width="150" height="58"></a>

      <button class="menu-btn" id="menuBtn" aria-label="فتح القائمة">
        ☰
      </button>

      <nav class="nav-links" id="navLinks">
