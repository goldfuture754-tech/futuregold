        <a href="#contact" class="nav-cta">اطلب الخدمة الآن</a>
      </nav>

    </div>
  </header>

  <!-- Hero -->
  <main id="home">

    <section class="hero">
      <div class="container hero-inner">

        <div class="hero-content">

          <div class="badge">
            💧 خدمة احترافية لتنظيف وعزل خزانات المياه
          </div>

          <h1>
            خزانك يحتاج تنظيف؟
