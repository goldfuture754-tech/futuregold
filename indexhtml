<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>المستقبل الذهبي | تنظيف وعزل خزانات المياه بالمنطقة الشرقية</title>

  <meta name="description" content="المستقبل الذهبي لخدمات تنظيف وتعقيم وعزل خزانات المياه للمنازل والفلل والمنشآت في المنطقة الشرقية.">
  <meta name="theme-color" content="#087f5b">
  <meta name="color-scheme" content="light">
  <!-- نسخة GitHub Pages: كل الصور محلية داخل مجلد images وبمسارات نسبية، لذلك لا تعتمد على روابط خارجية. -->

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, "Tahoma", sans-serif;
      background: #f7faf8;
      color: #17231d;
      line-height: 1.8;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      display: block;
      width: 100%;
    }

    :root {
      --green: #087f5b;
      --green-dark: #045c42;
      --green-light: #e8f7f0;
      --gold: #e0a52c;
      --dark: #102019;
      --gray: #66736d;
      --white: #ffffff;
      --shadow: 0 15px 45px rgba(15, 50, 35, 0.10);
      --radius: 22px;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* ===== Header ===== */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #e8eee9;
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-logo {
      width: 150px;
      height: 58px;
      object-fit: contain;
    }

    .logo {
      font-size: 22px;
      font-weight: 900;
      color: var(--green);
      white-space: nowrap;
    }

    .logo span {
      color: var(--gold);
    }

    .nav-links {
      display: flex;
      gap: 26px;
      align-items: center;
      font-weight: 700;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: var(--green);
    }

    .nav-cta {
      background: var(--green);
      color: white !important;
      padding: 10px 18px;
      border-radius: 12px;
    }

    .menu-btn {
      display: none;
      border: 0;
      background: var(--green-light);
      color: var(--green);
      width: 44px;
      height: 44px;
      border-radius: 12px;
      font-size: 22px;
      cursor: pointer;
    }

    /* ===== Hero ===== */

    .hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(100deg, rgba(4,60,43,.94), rgba(8,127,91,.72)), url("images/tank-cleaning.jpg") center/cover;
      color: white;
    }

    .hero-inner {
      min-height: 680px;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 55px;
      align-items: center;
      padding: 70px 0;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.22);
      padding: 8px 15px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(36px, 5vw, 64px);
      line-height: 1.25;
      font-weight: 900;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #ffd56a;
    }

    .hero p {
      font-size: 19px;
      max-width: 650px;
      color: #edf9f4;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      min-height: 54px;
      padding: 0 24px;
      border-radius: 14px;
      font-weight: 800;
      transition: .2s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-whatsapp {
      background: #20c76b;
      color: white;
      box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    .btn-call {
      background: white;
      color: var(--green-dark);
    }

    .hero-card {
      background: white;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,.25);
      transform: rotate(1deg);
    }

    .hero-card img {
      height: 410px;
      object-fit: cover;
    }

    .hero-card-info {
      color: var(--dark);
      padding: 18px 20px;
    }

    .hero-card-info strong {
      display: block;
      color: var(--green);
      font-size: 19px;
      margin-bottom: 4px;
    }

    .hero-card-info span {
      color: var(--gray);
      font-size: 14px;
    }

    /* ===== Trust ===== */

    .trust {
      background: white;
      border-bottom: 1px solid #e9efeb;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      text-align: center;
    }

    .trust-item {
      padding: 25px 15px;
      border-left: 1px solid #edf1ee;
    }

    .trust-item:last-child {
      border-left: 0;
    }

    .trust-item strong {
      display: block;
      color: var(--green);
      font-size: 18px;
    }

    .trust-item span {
      color: var(--gray);
      font-size: 13px;
    }

    /* ===== Sections ===== */

    section {
      padding: 85px 0;
    }

    .section-head {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-head small {
      color: var(--green);
      font-weight: 900;
      font-size: 14px;
    }

    .section-head h2 {
      font-size: clamp(28px, 4vw, 42px);
      margin: 8px 0 12px;
      color: var(--dark);
    }

    .section-head p {
      max-width: 680px;
      margin: auto;
      color: var(--gray);
    }

    /* ===== Services ===== */

    .services {
      background: #f7faf8;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service {
      background: white;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: .25s ease;
      border: 1px solid #edf2ee;
    }

    .service:hover {
      transform: translateY(-6px);
    }

    .service-img {
      width: 100%;
      height: 230px;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .service-content {
      padding: 23px;
    }

    .service-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      background: var(--green-light);
      color: var(--green);
      border-radius: 14px;
      font-size: 22px;
      margin-bottom: 15px;
    }

    .service h3 {
      font-size: 21px;
      margin-bottom: 8px;
    }

    .service p {
      color: var(--gray);
      font-size: 14px;
    }

    /* ===== Offer ===== */

    .offer {
      background: var(--green);
      color: white;
    }

    .offer-box {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: center;
    }

    .offer h2 {
      font-size: clamp(28px, 4vw, 44px);
      margin-bottom: 10px;
    }

    .offer p {
      color: #dff5eb;
    }

    .offer .btn {
      background: white;
      color: var(--green-dark);
      white-space: nowrap;
    }

    /* ===== Why ===== */

    .why-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 50px;
      align-items: center;
    }

    .why-image {
      border-radius: 28px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .why-image img {
      height: 470px;
      object-fit: cover;
    }

    .why-list {
      display: grid;
      gap: 18px;
    }

    .why-item {
      display: flex;
      gap: 15px;
      align-items: flex-start;
    }

    .check {
      flex: 0 0 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--green-light);
      color: var(--green);
      font-weight: 900;
      margin-top: 2px;
    }

    .why-item h3 {
      margin-bottom: 3px;
      font-size: 18px;
    }

    .why-item p {
      color: var(--gray);
      font-size: 14px;
    }

    /* ===== Areas ===== */

    .areas {
      background: #f7faf8;
    }

    .areas-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    .area {
      background: white;
      border: 1px solid #e4ebe6;
      padding: 13px 22px;
      border-radius: 50px;
      font-weight: 700;
      color: var(--green-dark);
      box-shadow: 0 5px 15px rgba(0,0,0,.04);
    }

    /* ===== CTA ===== */

    .final-cta {
      background: linear-gradient(100deg, rgba(5,82,59,.94), rgba(8,127,91,.82)), url("images/tank-insulation.jpg") center/cover;
      color: white;
      text-align: center;
    }

    .final-cta h2 {
      font-size: clamp(30px, 5vw, 48px);
      margin-bottom: 12px;
    }

    .final-cta p {
      color: #e6f7ef;
      margin-bottom: 27px;
    }

    .final-cta .hero-buttons {
      justify-content: center;
    }

    /* ===== Footer ===== */

    footer {
      background: #0b1913;
      color: #dce8e2;
      padding: 45px 0 90px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .footer-logo {
      color: white;
      font-size: 24px;
      font-weight: 900;
      margin-bottom: 10px;
    }

    .footer-logo span {
      color: #f0bb3e;
    }

    .footer p {
      color: #9daea6;
      max-width: 500px;
    }

    .footer-contact {
      display: grid;
      gap: 10px;
      justify-content: end;
      text-align: right;
    }

    .footer-contact a:hover {
      color: #5ee49a;
    }

    .copyright {
      border-top: 1px solid rgba(255,255,255,.1);
      margin-top: 30px;
      padding-top: 20px;
      text-align: center;
      color: #8c9c95;
      font-size: 13px;
    }

    /* ===== Floating Buttons ===== */

    .floating {
      position: fixed;
      left: 20px;
      bottom: 20px;
      z-index: 1000;
      display: grid;
      gap: 10px;
    }

    .float-btn {
      width: 55px;
      height: 55px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: white;
      font-size: 23px;
      box-shadow: 0 8px 25px rgba(0,0,0,.18);
    }

    .float-whatsapp {
      background: #20c76b;
    }

    .float-call {
      background: var(--green);
    }

    /* ===== Mobile Bar ===== */

    .mobile-bar {
      display: none;
    }

    /* ===== Responsive ===== */

    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        min-height: auto;
        padding: 55px 0 70px;
      }

      .hero-card {
        max-width: 600px;
        width: 100%;
        margin: auto;
      }

      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .why-grid {
        grid-template-columns: 1fr;
      }

      .why-image {
        max-width: 650px;
        margin: auto;
      }
    }

    @media (max-width: 700px) {
      header {
        position: sticky;
      }

      .nav {
        min-height: 65px;
      }

      .logo {
        font-size: 18px;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 65px;
        right: 4%;
        left: 4%;
        background: white;
        border-radius: 16px;
        padding: 15px;
        box-shadow: var(--shadow);
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links a {
        padding: 12px;
      }

      .nav-cta {
        text-align: center;
      }

      .hero {
        background-position: center;
      }

      .hero-inner {
        padding: 42px 0 55px;
        gap: 35px;
      }

      .hero h1 {
        font-size: 36px;
      }

      .hero p {
        font-size: 16px;
      }

      .hero-card img {
        height: 290px;
      }

      .hero-buttons {
        display: grid;
        grid-template-columns: 1fr;
      }

      .btn {
        width: 100%;
      }

      .trust-grid {
        grid-template-columns: 1fr;
      }

      .trust-item {
        border-left: 0;
        border-bottom: 1px solid #edf1ee;
      }

      .trust-item:last-child {
        border-bottom: 0;
      }

      section {
        padding: 65px 0;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .service-img {
        height: 230px;
      }

      .offer-box {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .offer .btn {
        width: 100%;
      }

      .why-image img {
        height: 350px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-contact {
        justify-content: start;
        text-align: right;
      }

      .floating {
        display: none;
      }

      .mobile-bar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        position: fixed;
        bottom: 0;
        right: 0;
        left: 0;
        z-index: 2000;
        background: white;
        box-shadow: 0 -5px 25px rgba(0,0,0,.13);
      }

      .mobile-bar a {
        height: 58px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        font-weight: 900;
      }

      .mobile-bar .wa {
        background: #20c76b;
        color: white;
      }

      .mobile-bar .call {
        background: var(--green);
        color: white;
      }
    }
  @media (max-width: 600px) {
      .brand-logo { width: 125px; height: 52px; }
    }
  </style>
